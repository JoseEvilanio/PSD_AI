<Window x:Class="Autoflyer.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Autoflyer.Wpf.ViewModels"
        xmlns:views="clr-namespace:Autoflyer.Wpf.Views"
        mc:Ignorable="d"
        Title="Autoflyer — Automação de Encartes (.NET 8 WPF)" 
        Height="700" Width="1080"
        MinHeight="600" MinWidth="850"
        Background="{StaticResource WindowBgBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <!-- Conteúdo Principal -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Cabeçalho -->
                <RowDefinition Height="Auto" /> <!-- Painel de Configurações de Arquivos -->
                <RowDefinition Height="*" />    <!-- DataGrid Editável de Ofertas -->
                <RowDefinition Height="Auto" /> <!-- Barra de Ações Inferior -->
                <RowDefinition Height="Auto" /> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- 1. Cabeçalho -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Autoflyer" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Sistema de Automação de Encartes Publicitários para Adobe Photoshop" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- 2. Painel de Arquivos -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Template PSD -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Template PSD:" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,4,10,4" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TemplatePath, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource CardBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" Margin="0,4,8,4" />
                    <Button Grid.Row="0" Grid.Column="2" Content="Procurar PSD..." Command="{Binding BrowseTemplateCommand}" Margin="0,4,0,4" />

                    <!-- Planilha de Ofertas -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Planilha (.xlsx/.csv):" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,4,10,4" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SpreadsheetPath, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource CardBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" Margin="0,4,8,4" />
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Procurar..." Command="{Binding BrowseSpreadsheetCommand}" Margin="0,4,6,4" />
                        <Button Content="Carregar Dados" Command="{Binding LoadSpreadsheetCommand}" Background="#0E639C" Foreground="#FFF" Margin="0,4,0,4" />
                    </StackPanel>

                    <!-- Pasta de Imagens -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Pasta de Fotos:" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,4,10,4" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ImagesDirPath, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource CardBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" Margin="0,4,8,4" />
                    <Button Grid.Row="2" Grid.Column="2" Content="Procurar Pasta..." Command="{Binding BrowseImagesDirCommand}" Margin="0,4,0,4" />
                </Grid>
            </Border>

            <!-- 3. Editor de Ofertas (DataGrid Editável em Tema Escuro) -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,14">
                <DataGrid ItemsSource="{Binding Offers}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="True"
                          CanUserDeleteRows="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#333333"
                          Background="{StaticResource SurfaceBgBrush}"
                          RowBackground="{StaticResource SurfaceBgBrush}"
                          AlternatingRowBackground="{StaticResource CardBgBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          BorderThickness="0">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#264F78" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Slot" Binding="{Binding Slot, Mode=TwoWay}" Width="55" />
                        <DataGridTextColumn Header="Nome / Descrição do Produto" Binding="{Binding Nome, Mode=TwoWay}" Width="3*" />
                        <DataGridTextColumn Header="Preço De (R$)" Binding="{Binding PrecoDe, StringFormat='N2', Mode=TwoWay}" Width="105" />
                        <DataGridTextColumn Header="Preço Por (R$)" Binding="{Binding PrecoPor, StringFormat='N2', Mode=TwoWay}" Width="110" />
                        <DataGridTextColumn Header="Unidade" Binding="{Binding Unidade, Mode=TwoWay}" Width="75" />
                        <DataGridTextColumn Header="Caminho da Imagem" Binding="{Binding ImagemPath, Mode=TwoWay}" Width="2*" />
                        <!-- Indicador de Conflito de Marca -->
                        <DataGridTemplateColumn Header="Status" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3" Padding="4,2" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#2D5A27" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasImageConflict}" Value="True">
                                                        <Setter Property="Background" Value="#A80000" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock TextAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#FFF">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="OK" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasImageConflict}" Value="True">
                                                            <Setter Property="Text" Value="CONFLITO" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 4. Ações Inferiores -->
            <Grid Grid.Row="3" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          Content="Otimizar ortografia e acentuação com IA (Ollama local)"
                          IsChecked="{Binding UseAiCorrection, Mode=TwoWay}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Content="Corrigir Nomes com IA"
                        Command="{Binding CorrectGrammarCommand}"
                        Margin="0,0,10,0" />

                <Button Grid.Column="2"
                        Content="▶ GERAR ENCARTE NO PHOTOSHOP"
                        Command="{Binding GenerateFlyerCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Padding="18,10"
                        FontSize="13" />
            </Grid>

            <!-- 5. Status Bar -->
            <StatusBar Grid.Row="4" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <StatusBarItem>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                </StatusBarItem>
            </StatusBar>
        </Grid>

        <!-- Overlay de Loading Animado do Photoshop (Visível apenas quando IsBusy == true) -->
        <views:PhotoshopLoadingOverlay Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
    </Grid>
</Window>
